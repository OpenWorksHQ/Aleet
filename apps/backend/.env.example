# Server
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
# Customer site URL — used for Stripe success/cancel redirects when APP_BASE_URL is unset
FRONTEND_URL=http://localhost:3001
DRIVER_PORTAL_URL=http://localhost:3002
# Comma-separated extra browser origins (e.g. Vercel preview URLs)
ALLOWED_ORIGINS=
# Set to false to disable auto-allow *.vercel.app (default: allowed)
# ALLOW_VERCEL_ORIGINS=false
API_URL=http://localhost:5000

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
# Optional. Default is 7d (matches admin/driver portal cookies).
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# ---------------------------------------------------------------------------
# SSN encryption at rest (src/utils/ssnCrypto.js)
# ---------------------------------------------------------------------------
# AES-256-GCM key for driver.ssn. EXACTLY 64 hex characters (32 bytes).
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Behavior when unset:
#   NODE_ENV=production → the app THROWS on any SSN read/write. An SSN written
#                         as plaintext is the bug this exists to prevent.
#   anywhere else       → SSNs stay plaintext after one loud warning, so local
#                         dev and `npm test` work without provisioning a key.
# A key that is set but malformed always throws — that is a typo, not an opt-out.
#
# Treat this like JWT_SECRET: never commit a real value, never reuse across
# environments. Losing it makes every stored SSN unrecoverable; rotating it
# requires decrypting with the old key and re-encrypting with the new one
# (the current migration only handles plaintext → v1).
#
# Backfill existing plaintext rows (idempotent, has a dry run):
#   node src/seeders/encryptExistingSsns.js --dry-run
#   node src/seeders/encryptExistingSsns.js
SSN_ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Checkr
CHECKR_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Email (Gmail SMTP — use a Google App Password, not your login password)
# GMAIL_USER           = Gmail account for SMTP login (base address, no +alias)
# GMAIL_FROM_EMAIL     = From address shown to recipients (may use +alias)
# INVESTOR_INBOX_EMAIL = where /teams form submissions are delivered
GMAIL_USER=
GMAIL_FROM_EMAIL=
GMAIL_APP_PASSWORD=
INVESTOR_INBOX_EMAIL=

# ---------------------------------------------------------------------------
# Seeders (src/seeders/) — LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Every seeder loads this file (apps/backend/.env), the same one src/server.js
# reads, and refuses to run when NODE_ENV=production.
#
# Escape hatch — ONLY set this if you genuinely intend to seed a live database.
# Seeders create accounts with known passwords and print them to stdout.
# ALLOW_PROD_SEED=true
#
# Seed account passwords. When unset, the seeders fall back to the local-dev
# defaults committed in src/seeders/*.js and print a loud warning. Those
# defaults are public — set real values for anything that is not your laptop.
#
# adminSeeder.js / index.js seed:admin
SEED_ADMIN_PASSWORD=
SEED_BOOKING_MANAGER_PASSWORD=
SEED_USER_MANAGER_PASSWORD=
# index.js seed:users (sample driver + customer)
SEED_DRIVER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
# paymentTestAccountsSeeder.js (Stripe test-mode QA accounts)
SEED_TEST_ACCOUNT_PASSWORD=
# sacAqdTestSeeder.js + resetTestDriverPasswords.js (sac-pro-* test drivers)
SAC_TEST_PASSWORD=
# sacAqdTestSeeder.js tuning (optional)
# SAC_REGION_ID=
# SAC_MIN_DRIVERS=4
